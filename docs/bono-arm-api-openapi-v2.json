{
  "openapi": "3.1.0",
  "info": {
    "title": "Bono API for ARMember v2",
    "description": "Schema-first ARMember endpoints. Payment items follow the registered REST item schema, discoverable via OPTIONS on the payments route. Errors use the standard WordPress REST error shape.",
    "version": "2.3.0-beta.3"
  },
  "servers": [
    {
      "url": "{siteUrl}/wp-json",
      "description": "WordPress REST root",
      "variables": {
        "siteUrl": {
          "default": "https://example.com"
        }
      }
    }
  ],
  "security": [
    {
      "basicAuth": []
    }
  ],
  "paths": {
    "/bono_armember/v2/payments": {
      "get": {
        "summary": "List successful payments using cursor pagination",
        "description": "Returns an envelope with the payment page and cursor metadata. payer_email and notes are present only when context=edit.",
        "parameters": [
          {
            "name": "after_invoice_id",
            "in": "query",
            "description": "Return invoices with IDs greater than this cursor.",
            "schema": {
              "type": "integer",
              "minimum": 0,
              "default": 0
            }
          },
          {
            "name": "plan_id",
            "in": "query",
            "description": "Limit results to an ARMember plan.",
            "schema": {
              "type": "integer",
              "minimum": 1
            }
          },
          {
            "name": "per_page",
            "in": "query",
            "schema": {
              "type": "integer",
              "minimum": 1,
              "maximum": 100,
              "default": 50
            }
          },
          {
            "name": "context",
            "in": "query",
            "description": "Scope of the response. edit adds payer_email and notes and requires the bono_arm_api_read_payer_details capability; without it the request fails with 403 rest_forbidden_context.",
            "schema": {
              "type": "string",
              "enum": [
                "view",
                "edit"
              ],
              "default": "view"
            }
          },
          {
            "name": "include_totals",
            "in": "query",
            "description": "Run the extra COUNT query and emit the X-WP-Total headers.",
            "schema": {
              "type": "boolean",
              "default": false
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Payment page",
            "headers": {
              "X-WP-Total": {
                "description": "Rows matching the filters *after* the requested cursor, not the size of the whole collection. Present only when include_totals=true.",
                "schema": {
                  "type": "integer"
                }
              },
              "X-WP-TotalPages": {
                "description": "ceil(X-WP-Total / per_page). Derived from the post-cursor count, so it shrinks as the client pages forward. Present only when include_totals=true.",
                "schema": {
                  "type": "integer"
                }
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PaymentsPage"
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/RestError"
          },
          "401": {
            "$ref": "#/components/responses/RestError"
          },
          "403": {
            "$ref": "#/components/responses/RestError"
          },
          "503": {
            "$ref": "#/components/responses/RestError"
          }
        }
      }
    },
    "/bono_armember/v2/members/{user_id}/activate": {
      "post": {
        "summary": "Activate a member",
        "description": "Sets the member to active in ARMember. Returns 404 bono_arm_api_member_not_found when the user has no ARMember member record. Fires the bono_arm_api_member_activated action on success.",
        "parameters": [
          {
            "name": "user_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "minimum": 1
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "send_email": {
                    "type": "boolean",
                    "default": false,
                    "description": "Send ARMember's manual-activation email when that template is configured."
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Member activated",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ActivateMemberResponse"
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/RestError"
          },
          "401": {
            "$ref": "#/components/responses/RestError"
          },
          "403": {
            "$ref": "#/components/responses/RestError"
          },
          "404": {
            "$ref": "#/components/responses/RestError"
          },
          "503": {
            "$ref": "#/components/responses/RestError"
          }
        }
      }
    },
    "/bono_armember/v2/members/{user_id}": {
      "delete": {
        "summary": "Delete a single-site member and reassign content",
        "description": "Deletes the WordPress user through ARMember's delete lifecycle, which cancels the member's recurring gateway subscriptions. Users who can manage_options are refused with 403 bono_arm_api_delete_protected unless the bono_arm_api_can_delete_member filter allows them. Fires the bono_arm_api_member_deleted action on success.",
        "parameters": [
          {
            "name": "user_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "minimum": 1
            }
          },
          {
            "name": "reassign_user_id",
            "in": "query",
            "required": true,
            "description": "Existing user who inherits the deleted member's content. Must differ from user_id.",
            "schema": {
              "type": "integer",
              "minimum": 1
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Member deleted",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/DeleteMemberResponse"
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/RestError"
          },
          "401": {
            "$ref": "#/components/responses/RestError"
          },
          "403": {
            "$ref": "#/components/responses/RestError"
          },
          "404": {
            "$ref": "#/components/responses/RestError"
          },
          "500": {
            "$ref": "#/components/responses/RestError"
          },
          "501": {
            "$ref": "#/components/responses/RestError"
          },
          "503": {
            "$ref": "#/components/responses/RestError"
          }
        }
      }
    },
    "/bono_armember/v2/members/{user_id}/renewals": {
      "post": {
        "summary": "Preview or commit one natural renewal cycle",
        "description": "Requires bono_arm_api_renew_members AND bono_arm_api_activate_members, and both renewal/activation toggles. Supports inspected Pro 8.1.1 paid recurring manual subscriptions. Defaults to preview. First commit requires expected_state and Idempotency-Key. All responses use no-store. 409 in-progress includes Retry-After: 5. A partial/uncertain write returns 503 bono_arm_api_renewal_needs_reconciliation with operation_id; never retry with a new key. No card charge or ARMember delivery emails. Unsupported subscription errors include data.reason; suspension_reason_unverified requires explicit operator confirmation before a fresh preview. Malformed schedule fields identify data.field.",
        "parameters": [
          {
            "name": "user_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "minimum": 1
            }
          },
          {
            "name": "Idempotency-Key",
            "in": "header",
            "schema": {
              "type": "string",
              "pattern": "^[\\x21-\\x7e]{16,128}$"
            },
            "description": "Required for commits; same key with another command returns 409."
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/RenewalCommand"
              }
            }
          }
        },
        "responses": {
          "400": {
            "$ref": "#/components/responses/RestError"
          },
          "401": {
            "$ref": "#/components/responses/RestError"
          },
          "403": {
            "$ref": "#/components/responses/RestError"
          },
          "404": {
            "$ref": "#/components/responses/RestError"
          },
          "409": {
            "$ref": "#/components/responses/RestError"
          },
          "422": {
            "$ref": "#/components/responses/RestError"
          },
          "503": {
            "$ref": "#/components/responses/RestError"
          },
          "200": {
            "description": "Side-effect-free preview, or authorized completed replay (idempotent_replay=true).",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/RenewalResult"
                }
              }
            }
          },
          "201": {
            "description": "Verified completed renewal; exactly one cycle and one created/reused payment.",
            "headers": {
              "Location": {
                "schema": {
                  "type": "string"
                },
                "description": "Operation status URL."
              },
              "Cache-Control": {
                "schema": {
                  "const": "no-store"
                }
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/RenewalResult"
                }
              }
            }
          },
          "410": {
            "description": "Personal operation details were erased; reservations remain and the key cannot execute again."
          }
        }
      }
    },
    "/bono_armember/v2/renewals/{operation_id}": {
      "get": {
        "summary": "Read durable renewal state and reconciliation details",
        "description": "Requires both renewal and activation capabilities, including on replay. Remains readable when mutation toggles are disabled for recovery. All responses have Cache-Control: no-store. Journal states: in_progress, completed, resolved, needs_reconciliation. In-progress after a timeout may indicate an interrupted write: inspect before repair.",
        "parameters": [
          {
            "name": "operation_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "responses": {
          "401": {
            "$ref": "#/components/responses/RestError"
          },
          "403": {
            "$ref": "#/components/responses/RestError"
          },
          "404": {
            "$ref": "#/components/responses/RestError"
          },
          "200": {
            "description": "Durable journal record, containing result or step outcomes.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "operation_id",
                    "state",
                    "user_id",
                    "plan_id",
                    "actor_id",
                    "details"
                  ],
                  "properties": {
                    "operation_id": {
                      "type": "string"
                    },
                    "state": {
                      "enum": [
                        "in_progress",
                        "completed",
                        "resolved",
                        "needs_reconciliation"
                      ]
                    },
                    "user_id": {
                      "type": "integer",
                      "minimum": 1
                    },
                    "plan_id": {
                      "type": "integer",
                      "minimum": 1
                    },
                    "actor_id": {
                      "type": "integer",
                      "minimum": 1
                    },
                    "created_at": {
                      "type": "string"
                    },
                    "updated_at": {
                      "type": "string"
                    },
                    "details": {
                      "type": "object"
                    }
                  }
                }
              }
            }
          },
          "503": {
            "description": "Journal storage unavailable."
          }
        }
      }
    },
    "/bono_armember/v2/badges": {
      "get": {
        "summary": "List available badge definitions",
        "description": "Requires bono_arm_api_manage_badges and enabled Badge endpoints setting. Inspected ARMember Pro 8.1.1 badge support. No request body. Removal preserves other badges and definitions; automatic rules may award it again. User list reports stored assignments, not current display eligibility. Multisite target must belong to this site. Avoid concurrent native admin/cron edits.",
        "parameters": [],
        "responses": {
          "401": {
            "$ref": "#/components/responses/RestError"
          },
          "403": {
            "$ref": "#/components/responses/RestError"
          },
          "503": {
            "$ref": "#/components/responses/RestError"
          },
          "200": {
            "description": "Successful response. changed=false when already in the requested state.",
            "headers": {
              "Cache-Control": {
                "schema": {
                  "type": "string",
                  "const": "no-store"
                }
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/BadgeList"
                }
              }
            }
          }
        }
      }
    },
    "/bono_armember/v2/members/{user_id}/badges": {
      "get": {
        "summary": "List stored badges assigned to a user",
        "description": "Requires bono_arm_api_manage_badges and enabled Badge endpoints setting. Inspected ARMember Pro 8.1.1 badge support. No request body. Removal preserves other badges and definitions; automatic rules may award it again. User list reports stored assignments, not current display eligibility. Multisite target must belong to this site. Avoid concurrent native admin/cron edits.",
        "parameters": [
          {
            "name": "user_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "minimum": 1
            }
          }
        ],
        "responses": {
          "400": {
            "$ref": "#/components/responses/RestError"
          },
          "401": {
            "$ref": "#/components/responses/RestError"
          },
          "403": {
            "$ref": "#/components/responses/RestError"
          },
          "404": {
            "$ref": "#/components/responses/RestError"
          },
          "409": {
            "$ref": "#/components/responses/RestError"
          },
          "503": {
            "$ref": "#/components/responses/RestError"
          },
          "200": {
            "description": "Successful response. changed=false when already in the requested state.",
            "headers": {
              "Cache-Control": {
                "schema": {
                  "type": "string",
                  "const": "no-store"
                }
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/BadgeList"
                }
              }
            }
          }
        }
      }
    },
    "/bono_armember/v2/members/{user_id}/badges/{badge_id}": {
      "put": {
        "summary": "Assign an existing badge idempotently",
        "description": "Requires bono_arm_api_manage_badges and enabled Badge endpoints setting. Inspected ARMember Pro 8.1.1 badge support. No request body. Removal preserves other badges and definitions; automatic rules may award it again. User list reports stored assignments, not current display eligibility. Multisite target must belong to this site. Avoid concurrent native admin/cron edits.",
        "parameters": [
          {
            "name": "user_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "minimum": 1
            }
          },
          {
            "name": "badge_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "minimum": 1
            }
          }
        ],
        "responses": {
          "400": {
            "$ref": "#/components/responses/RestError"
          },
          "401": {
            "$ref": "#/components/responses/RestError"
          },
          "403": {
            "$ref": "#/components/responses/RestError"
          },
          "404": {
            "$ref": "#/components/responses/RestError"
          },
          "409": {
            "$ref": "#/components/responses/RestError"
          },
          "503": {
            "$ref": "#/components/responses/RestError"
          },
          "200": {
            "description": "Successful response. changed=false when already in the requested state.",
            "headers": {
              "Cache-Control": {
                "schema": {
                  "type": "string",
                  "const": "no-store"
                }
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/BadgeMutation"
                }
              }
            }
          }
        }
      },
      "delete": {
        "summary": "Remove all target badge awards from a user idempotently",
        "description": "Requires bono_arm_api_manage_badges and enabled Badge endpoints setting. Inspected ARMember Pro 8.1.1 badge support. No request body. Removal preserves other badges and definitions; automatic rules may award it again. User list reports stored assignments, not current display eligibility. Multisite target must belong to this site. Avoid concurrent native admin/cron edits.",
        "parameters": [
          {
            "name": "user_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "minimum": 1
            }
          },
          {
            "name": "badge_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "minimum": 1
            }
          }
        ],
        "responses": {
          "400": {
            "$ref": "#/components/responses/RestError"
          },
          "401": {
            "$ref": "#/components/responses/RestError"
          },
          "403": {
            "$ref": "#/components/responses/RestError"
          },
          "404": {
            "$ref": "#/components/responses/RestError"
          },
          "409": {
            "$ref": "#/components/responses/RestError"
          },
          "503": {
            "$ref": "#/components/responses/RestError"
          },
          "200": {
            "description": "Successful response. changed=false when already in the requested state.",
            "headers": {
              "Cache-Control": {
                "schema": {
                  "type": "string",
                  "const": "no-store"
                }
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/BadgeMutation"
                }
              }
            }
          }
        }
      }
    },
    "/bono_armember/v2/renewals/{operation_id}/resolve": {
      "post": {
        "summary": "Record administrator reconciliation without replaying vendor writes",
        "description": "Requires renewal and activation capabilities plus manage_options. Available with mutation toggles disabled. Explicit operator attestation after inspecting or repairing ARMember. All payment reservations remain; a reversed cycle releases only its cycle reservation.",
        "parameters": [
          {
            "name": "operation_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "confirm_reconciled",
                  "cycle_stands",
                  "payment_stands"
                ],
                "properties": {
                  "confirm_reconciled": {
                    "type": "boolean",
                    "enum": [
                      true
                    ]
                  },
                  "cycle_stands": {
                    "type": "boolean"
                  },
                  "payment_stands": {
                    "type": "boolean"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Resolution recorded or identical replay."
          },
          "400": {
            "description": "Invalid attestation."
          },
          "401": {
            "description": "Authentication required."
          },
          "403": {
            "description": "Required capabilities missing."
          },
          "404": {
            "description": "Operation or journal schema absent."
          },
          "409": {
            "description": "Live member lock or conflicting resolution/state."
          },
          "503": {
            "description": "Journal update failed."
          },
          "410": {
            "description": "Operation details already erased."
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "basicAuth": {
        "type": "http",
        "scheme": "basic",
        "description": "Use a WordPress administrator username and Application Password."
      }
    },
    "schemas": {
      "Payment": {
        "type": "object",
        "description": "Mirrors the registered REST item schema (bono-arm-payment). payer_email and notes are edit-context only.",
        "properties": {
          "id": {
            "type": "integer",
            "readOnly": true
          },
          "invoice_id": {
            "type": "integer",
            "readOnly": true
          },
          "username": {
            "type": "string",
            "readOnly": true
          },
          "payer_email": {
            "type": "string",
            "format": "email",
            "readOnly": true,
            "description": "Only present when context=edit."
          },
          "paid_amount": {
            "type": "string",
            "readOnly": true,
            "description": "Currency and amount, joined with a space."
          },
          "payment_gateway": {
            "type": "string",
            "readOnly": true
          },
          "payment_date": {
            "type": "string",
            "format": "date-time",
            "readOnly": true,
            "description": "ISO 8601 in UTC, converted from the site-local time ARMember stores. Empty when ARMember recorded no date."
          },
          "notes": {
            "type": "string",
            "readOnly": true,
            "description": "Only present when context=edit. The manual-payment note, or ARMember's manual_by label. Empty when neither is set."
          },
          "transaction_status": {
            "type": "string",
            "readOnly": true
          }
        }
      },
      "PaymentsPage": {
        "type": "object",
        "required": [
          "payments",
          "pagination",
          "context"
        ],
        "properties": {
          "payments": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Payment"
            }
          },
          "pagination": {
            "type": "object",
            "required": [
              "per_page",
              "next_cursor",
              "has_more"
            ],
            "properties": {
              "per_page": {
                "type": "integer"
              },
              "next_cursor": {
                "type": [
                  "integer",
                  "null"
                ],
                "description": "Pass as after_invoice_id to fetch the next page. Null when the page is empty."
              },
              "has_more": {
                "type": "boolean"
              }
            }
          },
          "context": {
            "type": "string",
            "enum": [
              "view",
              "edit"
            ]
          }
        }
      },
      "ActivateMemberResponse": {
        "type": "object",
        "required": [
          "user_id",
          "primary_status",
          "secondary_status",
          "email_sent"
        ],
        "properties": {
          "user_id": {
            "type": "integer"
          },
          "primary_status": {
            "type": "integer"
          },
          "secondary_status": {
            "type": "integer"
          },
          "email_sent": {
            "type": "boolean"
          }
        }
      },
      "DeleteMemberResponse": {
        "type": "object",
        "required": [
          "user_id",
          "user_login",
          "reassigned_to_user_id",
          "cleanup_mode"
        ],
        "properties": {
          "user_id": {
            "type": "integer"
          },
          "user_login": {
            "type": "string"
          },
          "reassigned_to_user_id": {
            "type": "integer"
          },
          "cleanup_mode": {
            "type": "string",
            "enum": [
              "automatic_hooks",
              "manual_fallback"
            ]
          }
        }
      },
      "RestError": {
        "type": "object",
        "description": "Standard WordPress REST error shape.",
        "required": [
          "code",
          "message",
          "data"
        ],
        "properties": {
          "code": {
            "type": "string",
            "examples": [
              "bono_arm_api_feature_disabled",
              "bono_arm_api_self_delete",
              "rest_forbidden"
            ]
          },
          "message": {
            "type": "string"
          },
          "data": {
            "type": "object",
            "properties": {
              "status": {
                "type": "integer"
              }
            }
          }
        }
      },
      "RenewalCommand": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "plan_id",
          "payment"
        ],
        "properties": {
          "plan_id": {
            "type": "integer",
            "minimum": 1
          },
          "dry_run": {
            "type": "boolean",
            "default": true
          },
          "expected_state": {
            "type": "string",
            "maxLength": 100,
            "description": "Preview token, bound to the actor, command and state; required on first commit, expires after 15 minutes."
          },
          "payment": {
            "oneOf": [
              {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "mode",
                  "reference",
                  "payer_name",
                  "amount",
                  "currency",
                  "paid_at"
                ],
                "properties": {
                  "mode": {
                    "const": "create"
                  },
                  "reference": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 191,
                    "pattern": "^[^\\x00-\\x20\\x7f]+$"
                  },
                  "payer_name": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 200
                  },
                  "amount": {
                    "type": "string",
                    "pattern": "^(0|[1-9][0-9]{0,9})(\\.[0-9]{1,6})?$",
                    "description": "Positive exact decimal total, matching the selected stored cycle including tax."
                  },
                  "currency": {
                    "type": "string",
                    "pattern": "^[A-Z]{3}$"
                  },
                  "paid_at": {
                    "type": "string",
                    "format": "date-time",
                    "description": "Actual received-payment timestamp with an explicit timezone offset."
                  }
                }
              },
              {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "mode",
                  "payment_log_id"
                ],
                "properties": {
                  "mode": {
                    "const": "existing"
                  },
                  "payment_log_id": {
                    "type": "integer",
                    "minimum": 1
                  }
                },
                "description": "Successful manual payment for this member/plan/total/currency. Its structured purpose must identify payer_name, start_plan and completed_cycles; see the renewal guide."
              }
            ]
          },
          "suspension_reason": {
            "type": "string",
            "enum": [
              "nonpayment"
            ],
            "description": "Operator-confirmed cause of an overdue target plan suspension when historical payment evidence is ambiguous. Include unchanged in preview, commit and retries. Does not override unrelated restrictions."
          }
        }
      },
      "RenewalState": {
        "type": "object",
        "required": [
          "primary_status",
          "secondary_status",
          "completed_cycles",
          "next_due_at"
        ],
        "properties": {
          "primary_status": {
            "type": "integer"
          },
          "secondary_status": {
            "type": "integer"
          },
          "completed_cycles": {
            "type": "integer"
          },
          "next_due_at": {
            "type": "string",
            "format": "date-time"
          },
          "expires_at": {
            "type": "string",
            "format": "date-time",
            "description": "Real finite agreement expiry, when present."
          },
          "entitlement_active": {
            "type": "boolean"
          }
        }
      },
      "RenewalPayment": {
        "type": "object",
        "properties": {
          "mode": {
            "enum": [
              "create",
              "existing"
            ]
          },
          "created": {
            "type": "boolean"
          },
          "will_create": {
            "type": "boolean"
          },
          "payment_log_id": {
            "type": [
              "integer",
              "null"
            ]
          },
          "invoice_id": {
            "type": "integer",
            "minimum": 1
          },
          "reference": {
            "type": "string"
          },
          "amount": {
            "type": "string"
          },
          "currency": {
            "type": "string"
          }
        }
      },
      "RenewalResult": {
        "type": "object",
        "properties": {
          "dry_run": {
            "type": "boolean"
          },
          "can_execute": {
            "type": "boolean"
          },
          "expected_state": {
            "type": "string"
          },
          "expires_at": {
            "type": "string",
            "format": "date-time",
            "description": "Preview-token expiry."
          },
          "operation_id": {
            "type": "string",
            "format": "uuid"
          },
          "state": {
            "const": "completed"
          },
          "idempotent_replay": {
            "type": "boolean"
          },
          "user_id": {
            "type": "integer",
            "minimum": 1
          },
          "plan_id": {
            "type": "integer",
            "minimum": 1
          },
          "cycles_to_advance": {
            "const": 1
          },
          "cycles_advanced": {
            "const": 1
          },
          "before": {
            "$ref": "#/components/schemas/RenewalState"
          },
          "after": {
            "$ref": "#/components/schemas/RenewalState"
          },
          "payment": {
            "$ref": "#/components/schemas/RenewalPayment"
          },
          "notifications": {
            "type": "object",
            "properties": {
              "policy": {
                "const": "suppressed"
              }
            }
          }
        }
      },
      "Badge": {
        "type": "object",
        "required": [
          "badge_id",
          "name",
          "icon"
        ],
        "properties": {
          "badge_id": {
            "type": "integer",
            "minimum": 1
          },
          "name": {
            "type": "string"
          },
          "icon": {
            "type": "string"
          }
        }
      },
      "BadgeList": {
        "type": "object",
        "required": [
          "badges"
        ],
        "properties": {
          "badges": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Badge"
            }
          }
        }
      },
      "BadgeMutation": {
        "type": "object",
        "required": [
          "user_id",
          "badge_id",
          "assigned",
          "changed"
        ],
        "properties": {
          "user_id": {
            "type": "integer"
          },
          "badge_id": {
            "type": "integer"
          },
          "assigned": {
            "type": "boolean"
          },
          "changed": {
            "type": "boolean"
          }
        }
      }
    },
    "responses": {
      "RestError": {
        "description": "WordPress REST error",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/RestError"
            }
          }
        }
      }
    }
  }
}
