{
  "name": "renatobo/bono-arm-api",
  "description": "Development tooling for Bono API for ARMember.",
  "license": "GPL-2.0-or-later",
  "type": "wordpress-plugin",
  "require-dev": {
    "dealerdirect/phpcodesniffer-composer-installer": "^1.0",
    "phpunit/phpunit": "^9.6",
    "squizlabs/php_codesniffer": "^3.13",
    "wp-coding-standards/wpcs": "^3.4.1",
    "yoast/phpunit-polyfills": "^2.0"
  },
  "config": {
    "allow-plugins": {
      "dealerdirect/phpcodesniffer-composer-installer": true
    },
    "platform": {
      "php": "7.4.0"
    },
    "sort-packages": true
  },
  "scripts": {
    "lint": "find . -path './vendor' -prune -o -path './temp' -prune -o -name '*.php' -exec php -l {} \\;",
    "phpcs": "phpcs",
    "test": "phpunit",
    "check": ["@lint", "@phpcs", "@test"]
  }
}
